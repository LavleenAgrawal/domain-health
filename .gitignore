# Local environment
.env
.env.*
!.env.example
/.tools/

# Dependencies and downloaded installers
/api/vendor/
/web/node_modules/
/api/composer.phar
/api/composer-setup.php

# Build and test output
/web/.next/
/web/.next-build/
/api/.phpunit.result.cache
/api/bootstrap/cache/*
!/api/bootstrap/cache/.gitignore

# Runtime files
*.log
*.err
*.err.log
/api/storage/*.key
/api/storage/framework/cache/data/*
!/api/storage/framework/cache/data/.gitignore
/api/storage/framework/sessions/*
!/api/storage/framework/sessions/.gitignore
/api/storage/framework/views/*
!/api/storage/framework/views/.gitignore
/api/storage/logs/*
!/api/storage/logs/.gitignore

# Editor and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
