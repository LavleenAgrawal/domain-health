APP_NAME="Domain Health Checker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000
LOG_CHANNEL=stack
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=domain_health
DB_USERNAME=root
DB_PASSWORD=
CACHE_STORE=redis
QUEUE_CONNECTION=database
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
DNS_RESOLVER_URL=https://cloudflare-dns.com/dns-query
DNS_HTTP_PROXY=
DNS_CA_BUNDLE=
DNS_TIMEOUT_SECONDS=4
DNS_DOMAIN_DEADLINE_SECONDS=20
SURBL_ENABLED=false
SPAMHAUS_ENABLED=false
SPAMRATS_ENABLED=false
UPLOAD_MAX_KB=5120
UPLOAD_MAX_ROWS=10000
RESULT_RETENTION_DAYS=30
BLACKLIST_SOURCES=spamhaus_zen,spamrats
