{
  "name": "domain-health/api",
  "type": "project",
  "description": "Laravel REST API for Domain Health Checker",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0",
    "laravel/sanctum": "^4.0",
    "predis/predis": "^3.2"
  },
  "require-dev": {
    "laravel/pint": "^1.13",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": { "psr-4": { "App\\": "app/" } },
  "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
  "scripts": {
    "test": ["@php vendor/bin/phpunit"],
    "lint": ["@php vendor/bin/pint --test"]
  },
  "config": { "sort-packages": true, "allow-plugins": { "pestphp/pest-plugin": true } },
  "minimum-stability": "stable",
  "prefer-stable": true
}
